<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme (no AndroidX dependency). The app is a full-screen
         WebView, so only the status-bar / background colors matter. -->
    <style name="Theme.LeadLoop" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowBackground">@color/brand_dark</item>
    </style>
</resources>
